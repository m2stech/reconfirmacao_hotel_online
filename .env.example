# OpenAI (server-only)
OPENAI_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: never expose to the client
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=

GOOGLE_PLACES_API_KEY=

TAVILY_API_KEY=

# Vercel Cron Jobs (Milestone 10) — a Vercel assina o disparo do cron com
# `Authorization: Bearer <CRON_SECRET>`; sem isso as rotas /api/jobs/* fica-
# riam acessíveis publicamente sem autenticação (não há sessão de usuário
# num disparo de Cron Job). Gerar um valor aleatório forte, nunca reusar
# outro secret do projeto.
CRON_SECRET=

# uuid de public.profiles de um usuário "sistema" fixo (criado uma única vez
# via src/lib/jobs/__integration__/criar-usuario-sistema.manual.ts), usado
# como actor_id em public.audit_log para ações automáticas dos jobs — essa
# coluna é NOT NULL (schema do TripQuote, compartilhado, não alterável por
# este sistema), então não pode ficar null nunca.
CRON_SYSTEM_USER_ID=

# Microsoft Graph (reconfirmação de hotéis) — client credentials flow.
# Server-only: MS_GRAPH_CLIENT_SECRET nunca deve viver no código-fonte.
# MS_GRAPH_AUTHORIZED_EMAIL deve ser sempre uma conta de TESTE até o
# checklist de troca de ambiente do Milestone 13 (CLAUDE.md / PRD §7.1,
# §10 item 1) — nunca produtos1@bvgroup.com.br fora de produção.
MS_GRAPH_CLIENT_ID=
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_AUTHORIZED_EMAIL=
