# OpenAI (server-only)
OPENAI_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: never expose to the client
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=

GOOGLE_PLACES_API_KEY=

TAVILY_API_KEY=

# Microsoft Graph (reconfirmação de hotéis) — client credentials flow.
# Nenhum destes é um client secret por si só, mas são identificadores de
# configuração e não devem viver no código-fonte.
MS_GRAPH_CLIENT_ID=
MS_GRAPH_TENANT_ID=
MS_GRAPH_AUTHORIZED_EMAIL=
